# ==============================================================================
# AuPro Production Environment Configuration & Deployment Template
# ==============================================================================

# 1. DATABASE & CLOUD PERSISTENCE (Solves Vercel/Render Ephemeral Disk Reset)
# Connects AuPro to Supabase / PostgreSQL so all 4,000+ students share real ACID transactions.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# 2. CRYPTOGRAPHIC AUTHENTICATION & SESSION SIGNING
# 256-bit cryptographically secure secret used for HMAC-SHA256 OTP signing and session tokens.
AUTH_SECRET=aupro-andhra-university-otp-signing-secret-2026-production-vault

# 3. PRODUCTION DOMAIN & CORS RESTRICTIONS
# Protects APIs against unauthorized cross-origin requests.
ALLOWED_ORIGIN=https://aupro1.vercel.app

# 4. UNIVERSITY EMAIL OTP DISPATCH (Resend / Brevo)
# Real SMTP/API dispatch for official @andhrauniversity.edu.in student verifications.
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz
EMAIL_FROM=admissions@andhrauniversity.edu.in

# 5. ERROR MONITORING & DISASTER TELEMETRY (Sentry / Datadog)
# Instant alerts on unhandled errors, latency spikes, and 500 status codes.
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=sntryu_123456789

# 6. HEAD ADMINISTRATOR DESIGNATED ROOT IDENTITY
HEAD_ADMIN_EMAIL=325506402371@andhrauniversity.edu.in
